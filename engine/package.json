{
  "name": "graveyard-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "graveyard": "./dist/cli.js"
  },
  "main": "./dist/schema.js",
  "exports": {
    ".": "./dist/schema.js",
    "./schema": "./dist/schema.js",
    "./build": "./dist/build.js",
    "./epitaph": "./dist/epitaph.js"
  },
  "scripts": {
