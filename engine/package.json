  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "knip": "5.64.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "fast-check": "3.22.0",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  }
